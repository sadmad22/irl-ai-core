{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/italics.schema.json",
  "title": "IRL Italics Editorial Formatting Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["italics_id", "brief_id", "report_id", "decision_id", "strategy_id", "config_id", "outline_editor_id", "details_to_include_id", "schema_version", "lifecycle_stage", "italics", "audit"],
  "properties": {
    "italics_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "config_id": {"type": "string", "minLength": 1},
    "outline_editor_id": {"type": "string", "minLength": 1},
    "details_to_include_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "italics_ready"},
    "italics": {"$ref": "#/$defs/italics"},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "method_version", "validation_status"],
      "properties": {
        "method": {"const": "deterministic-italics-editorial-contract"},
        "method_version": {"const": "v1"},
        "validation_status": {"const": "validated"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"italics": {"properties": {"enabled": {"const": false}}}}},
      "then": {"properties": {"italics": {"properties": {"max_per_section": {"const": 0}}}}
    },
    {
      "if": {"properties": {"italics": {"properties": {"required": {"const": true}}}}},
      "then": {"properties": {"italics": {"properties": {"enabled": {"const": true}}}}
    },
    {
      "if": {"properties": {"italics": {"properties": {"enabled": {"const": true}}}}},
      "then": {"properties": {"italics": {"properties": {"max_per_section": {"minimum": 1}}}}
    }
  ],
  "$defs": {
    "italics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "required", "max_per_section", "policy"],
      "properties": {
        "enabled": {"type": "boolean"},
        "required": {"type": "boolean"},
        "max_per_section": {"type": "integer", "minimum": 0},
        "policy": {"const": "editorial_emphasis_only"}
      }
    }
  }
}
