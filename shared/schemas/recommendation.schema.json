{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irl-ai-core.local/schemas/recommendation.schema.json",
  "title": "IRL AI Core Research Recommendation",
  "description": "Deterministic pre-decision recommendation derived from a canonical ResearchReport and explicit evidence lineage.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recommendation_id": { "type": "string", "minLength": 1 },
    "report_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "lifecycle_stage": { "type": "string", "const": "recommendation_ready" },
    "recommendation": { "type": "string", "enum": ["pursue", "defer", "reject"] },
    "priority": { "type": "string", "enum": ["high", "medium", "low"] },
    "content_type": { "type": ["string", "null"] },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent_fit": { "type": "number", "minimum": 0, "maximum": 1 },
        "serp_opportunity": { "type": "number", "minimum": 0, "maximum": 1 },
        "business_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "authority_fit": { "type": "number", "minimum": 0, "maximum": 1 },
        "research_completeness": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["intent_fit", "serp_opportunity", "business_value", "authority_fit", "research_completeness"]
    },
    "rationale": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "minItems": 1 },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "validation_status": { "type": "string", "enum": ["pending", "valid", "invalid"] }
      },
      "required": ["method", "version", "validation_status"]
    }
  },
  "required": [
    "recommendation_id", "report_id", "schema_version", "lifecycle_stage",
    "recommendation", "priority", "content_type", "score", "criteria",
    "rationale", "evidence_refs", "audit"
  ]
}
