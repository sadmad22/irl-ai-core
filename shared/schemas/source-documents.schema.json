{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irl-ai-core.local/schemas/source-documents.schema.json",
  "title": "IRL Source Documents",
  "description": "Fetched source documents with cache/revalidation metadata and immutable content identity.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "project_name": { "type": "string", "minLength": 1 },
    "request_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "acquisition_policy_version": { "type": "string", "minLength": 1 },
    "extraction_policy_version": { "type": "string", "minLength": 1 },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_document_id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "requested_url": { "type": "string", "format": "uri" },
          "final_url": { "type": "string", "format": "uri" },
          "provider": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["official", "institutional", "secondary"] },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "cache_checked_at": { "type": "string", "format": "date-time" },
          "http_status": { "type": "integer", "minimum": 200, "maximum": 299 },
          "content_type": { "type": "string", "minLength": 1 },
          "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "content_bytes": { "type": "integer", "minimum": 1 },
          "redirect_chain": {
            "type": "array",
            "maxItems": 5,
            "items": { "type": "string", "format": "uri" }
          },
          "etag": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "last_modified": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "html": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "normalized_text": { "type": "string", "minLength": 1 }
        },
        "required": [
          "source_document_id", "source_id", "requested_url", "final_url",
          "provider", "type", "retrieved_at", "cache_checked_at", "http_status",
          "content_type", "content_sha256", "content_bytes", "redirect_chain",
          "etag", "last_modified", "html", "title", "normalized_text"
        ]
      }
    }
  },
  "required": [
    "schema_version", "project_name", "request_fingerprint",
    "acquisition_policy_version", "extraction_policy_version", "documents"
  ]
}
