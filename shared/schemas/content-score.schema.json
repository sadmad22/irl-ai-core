{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/content-score.schema.json",
  "title": "IRL Content Score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_score_id",
    "brief_id",
    "report_id",
    "decision_id",
    "strategy_id",
    "integration_id",
    "schema_version",
    "lifecycle_stage",
    "score",
    "components",
    "context",
    "scoring_policy",
    "audit"
  ],
  "properties": {
    "content_score_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "integration_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "content_score_ready"},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality", "seo"],
      "properties": {
        "quality": {"$ref": "#/$defs/scored_component"},
        "seo": {"$ref": "#/$defs/scored_component"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic", "competitive", "configuration"],
      "properties": {
        "semantic": {"$ref": "#/$defs/context_signal"},
        "competitive": {"$ref": "#/$defs/context_signal"},
        "configuration": {"$ref": "#/$defs/context_signal"}
      }
    },
    "scoring_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality_weight", "seo_weight", "seo_scored_checks", "version"],
      "properties": {
        "quality_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "seo_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "seo_scored_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "validation_status": {"const": "validated"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["contract"],
      "properties": {"contract": {"type": "string", "minLength": 1}}
    },
    "scored_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "weight", "checks", "source"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "weight": {"type": "number", "minimum": 0, "maximum": 1},
        "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "context_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "scored", "reason", "source"],
      "properties": {
        "available": {"const": true},
        "scored": {"const": false},
        "reason": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
}
