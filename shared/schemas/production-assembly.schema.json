{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/production-assembly.schema.json",
  "title": "IRL Production Assembly v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assembly_id", "project_name", "schema_version", "lifecycle_stage", "lineage", "artifacts", "audit"],
  "properties": {
    "assembly_id": {"type": "string", "pattern": "^assembly_[a-f0-9]{16}$"},
    "project_name": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"enum": ["assembly_started", "inputs_validated", "artifacts_normalized", "production_assembly_ready", "failed"]},
    "lineage": {"$ref": "#/$defs/lineage"},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "audit": {"$ref": "#/$defs/audit"}
  },
  "allOf": [
    {"if": {"properties": {"lifecycle_stage": {"const": "production_assembly_ready"}}}, "then": {"properties": {"audit": {"properties": {"validation_status": {"const": "validated"}}}}}},
    {"if": {"properties": {"lifecycle_stage": {"const": "failed"}}}, "then": {"properties": {"audit": {"properties": {"validation_status": {"const": "failed"}}}}}},
    {"if": {"properties": {"lifecycle_stage": {"enum": ["inputs_validated", "artifacts_normalized", "production_assembly_ready"]}}}, "then": {"properties": {"artifacts": {"$ref": "#/$defs/artifactsReady"}}}}
  ],
  "$defs": {
    "s": {"type": "string", "minLength": 1},
    "sa": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/s"}},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "decision_id", "strategy_id", "brief_id", "draft_id", "quality_id"],
      "properties": {
        "report_id": {"$ref": "#/$defs/s"}, "decision_id": {"$ref": "#/$defs/s"}, "strategy_id": {"$ref": "#/$defs/s"},
        "brief_id": {"$ref": "#/$defs/s"}, "draft_id": {"$ref": "#/$defs/s"}, "quality_id": {"$ref": "#/$defs/s"},
        "config_id": {"$ref": "#/$defs/s"}, "semantic_id": {"$ref": "#/$defs/s"}, "optimization_id": {"$ref": "#/$defs/s"},
        "image_spec_id": {"$ref": "#/$defs/s"}, "alt_text_id": {"$ref": "#/$defs/s"},
        "external_links_id": {"$ref": "#/$defs/s"}, "internal_links_id": {"$ref": "#/$defs/s"}, "news_id": {"$ref": "#/$defs/s"}
      }
    },
    "articleDraft": {
      "type": "object", "additionalProperties": false,
      "required": ["draft_id", "brief_id", "report_id", "decision_id", "strategy_id", "lifecycle_stage", "content_type", "primary_keyword", "title", "slug", "sections"],
      "properties": {
        "draft_id": {"$ref": "#/$defs/s"}, "brief_id": {"$ref": "#/$defs/s"}, "report_id": {"$ref": "#/$defs/s"},
        "decision_id": {"$ref": "#/$defs/s"}, "strategy_id": {"$ref": "#/$defs/s"}, "lifecycle_stage": {"const": "draft_ready"},
        "content_type": {"enum": ["guide", "comparison", "buyer_guide", "article"]}, "primary_keyword": {"$ref": "#/$defs/s"},
        "title": {"$ref": "#/$defs/s"}, "slug": {"$ref": "#/$defs/s"},
        "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/draftSection"}},
        "tables": {"type": "array", "items": {"type": "object"}}
      }
    },
    "draftSection": {
      "type": "object", "additionalProperties": false,
      "required": ["section_id", "heading", "body", "purpose", "evidence_refs", "claims"],
      "properties": {
        "section_id": {"$ref": "#/$defs/s"}, "heading": {"$ref": "#/$defs/s"}, "body": {"$ref": "#/$defs/s"},
        "purpose": {"$ref": "#/$defs/s"}, "evidence_refs": {"$ref": "#/$defs/sa"},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/draftClaim"}}
      }
    },
    "draftClaim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "text", "evidence_refs", "grounding_status"],
      "properties": {"claim_id": {"$ref": "#/$defs/s"}, "text": {"$ref": "#/$defs/s"}, "evidence_refs": {"$ref": "#/$defs/sa"}, "grounding_status": {"enum": ["grounded", "blocked", "provisional"]}}
    },
    "quality": {"type": "object", "additionalProperties": true, "required": ["quality_id", "lifecycle_stage", "outcome", "audit"], "properties": {"quality_id": {"$ref": "#/$defs/s"}, "lifecycle_stage": {"const": "article_draft_quality_ready"}, "outcome": {"const": "passed"}, "audit": {"$ref": "#/$defs/validatedAudit"}}},
    "claimAudit": {"type": "object", "additionalProperties": true, "required": ["outcome", "audit"], "properties": {"outcome": {"const": "passed"}, "audit": {"$ref": "#/$defs/validatedAudit"}}},
    "editorialReview": {"type": "object", "additionalProperties": true, "required": ["outcome", "audit"], "properties": {"outcome": {"const": "approved"}, "audit": {"$ref": "#/$defs/validatedAudit"}}},
    "optimization": {"type": "object", "additionalProperties": false, "required": ["seo_title", "meta_description"], "properties": {"seo_title": {"$ref": "#/$defs/s"}, "meta_description": {"$ref": "#/$defs/s"}, "canonical_url": {"type": "string", "format": "uri"}}},
    "media": {
      "type": "object", "additionalProperties": false, "required": ["images"],
      "properties": {"images": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mediaImage"}}}
    },
    "mediaImage": {
      "type": "object", "additionalProperties": false,
      "required": ["image_id", "section_index", "placement", "prompt", "alt_text", "materialization_status"],
      "properties": {
        "image_id": {"$ref": "#/$defs/s"}, "section_index": {"type": "integer", "minimum": 0}, "placement": {"$ref": "#/$defs/s"},
        "prompt": {"$ref": "#/$defs/s"}, "alt_text": {"$ref": "#/$defs/s"}, "materialization_status": {"enum": ["specified", "materialized"]},
        "asset_ref": {"$ref": "#/$defs/s"}
      },
      "allOf": [{"if": {"properties": {"materialization_status": {"const": "materialized"}}}, "then": {"required": ["asset_ref"]}}]
    },
    "linking": {
      "type": "object", "additionalProperties": false, "required": ["internal", "external"],
      "properties": {"internal": {"type": "array", "items": {"$ref": "#/$defs/link"}}, "external": {"type": "array", "items": {"$ref": "#/$defs/link"}}}
    },
    "link": {
      "type": "object", "additionalProperties": false, "required": ["link_id", "target_url", "anchor_text", "placement"],
      "properties": {"link_id": {"$ref": "#/$defs/s"}, "section_id": {"$ref": "#/$defs/s"}, "section_index": {"type": "integer", "minimum": 0}, "target_url": {"type": "string", "format": "uri", "minLength": 1}, "anchor_text": {"$ref": "#/$defs/s"}, "placement": {"$ref": "#/$defs/s"}},
      "anyOf": [{"required": ["section_id"]}, {"required": ["section_index"]}]
    },
    "taxonomy": {"type": "object", "additionalProperties": false, "required": ["categories", "tags"], "properties": {"categories": {"$ref": "#/$defs/sa", "minItems": 1}, "tags": {"$ref": "#/$defs/sa"}}},
    "productionIntent": {"type": "object", "additionalProperties": false, "required": ["target", "mode", "publish", "human_approval_required"], "properties": {"target": {"const": "wordpress"}, "mode": {"const": "wordpress_draft"}, "publish": {"const": false}, "human_approval_required": {"const": true}}},
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["article_draft", "quality", "claim_audit", "editorial_review", "optimization", "media", "linking", "taxonomy", "production_intent"],
      "properties": {
        "article_draft": {"$ref": "#/$defs/articleDraft"}, "quality": {"$ref": "#/$defs/quality"}, "claim_audit": {"$ref": "#/$defs/claimAudit"},
        "editorial_review": {"$ref": "#/$defs/editorialReview"}, "optimization": {"$ref": "#/$defs/optimization"}, "media": {"$ref": "#/$defs/media"},
        "linking": {"$ref": "#/$defs/linking"}, "taxonomy": {"$ref": "#/$defs/taxonomy"}, "production_intent": {"$ref": "#/$defs/productionIntent"}
      }
    },
    "artifactsReady": {"allOf": [{"$ref": "#/$defs/artifacts"}, {"properties": {"media": {"properties": {"images": {"items": {"properties": {"materialization_status": {"const": "materialized"}}}}}}}}]},
    "validatedAudit": {"type": "object", "required": ["validation_status"], "properties": {"validation_status": {"const": "validated"}}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["method", "version", "validation_status"], "properties": {"method": {"const": "production_assembly"}, "version": {"const": "v1"}, "validation_status": {"enum": ["pending", "validated", "failed"]}}}
  }
}