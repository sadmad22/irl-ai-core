{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irl-ai-core.local/schemas/canonical-evidence-lineage.schema.json",
  "title": "IRL Canonical Evidence Lineage Index",
  "description": "Deterministic bridge lineage from canonical Evidence back to the accepted claim candidate, source document, and extracted passage bindings.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "project_name": { "type": "string", "minLength": 1 },
    "request_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "acquisition_policy_version": { "type": "string", "minLength": 1 },
    "extraction_policy_version": { "type": "string", "minLength": 1 },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "candidate_id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "source_document_id": { "type": "string", "minLength": 1 },
          "passage_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": [
          "evidence_id",
          "candidate_id",
          "source_id",
          "source_document_id",
          "passage_ids"
        ]
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "schema_version",
    "project_name",
    "request_fingerprint",
    "acquisition_policy_version",
    "extraction_policy_version",
    "bindings",
    "evidence_ids"
  ]
}
