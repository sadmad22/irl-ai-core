{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://insurancereviewlab.com/schemas/seo-strategy.schema.json",
  "title":"IRL SEO Strategy",
  "type":"object","additionalProperties":false,
  "required":["seo_strategy_id","brief_id","report_id","decision_id","strategy_id","schema_version","lifecycle_stage","primary_keyword","search_intent","title_requirements","meta_description_requirements","heading_requirements","topical_entities","questions_to_answer","internal_link_targets","schema_requirements","image_alt_requirements","evidence_refs","audit"],
  "properties":{
    "seo_strategy_id":{"type":"string","minLength":1},"brief_id":{"type":"string","minLength":1},"report_id":{"type":"string","minLength":1},"decision_id":{"type":"string","minLength":1},"strategy_id":{"type":"string","minLength":1},
    "schema_version":{"const":"1.0"},"lifecycle_stage":{"const":"seo_strategy_ready"},
    "primary_keyword":{"type":"string","minLength":1},"secondary_keywords":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "search_intent":{"type":"string","minLength":1},"title_requirements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"meta_description_requirements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"heading_requirements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "topical_entities":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"questions_to_answer":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"internal_link_targets":{"type":"array","items":{"type":"string","minLength":1}},
    "schema_requirements":{"type":"array","items":{"type":"string","minLength":1}},"image_alt_requirements":{"type":"array","items":{"type":"string","minLength":1}},
    "evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "audit":{"type":"object","additionalProperties":false,"required":["method","version","validation_status"],"properties":{"method":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"validation_status":{"const":"validated"}}}
  }
}
