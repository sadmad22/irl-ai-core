{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/ai-image.schema.json",
  "title": "IRL AI Image Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image_spec_id",
    "brief_id",
    "report_id",
    "decision_id",
    "strategy_id",
    "config_id",
    "draft_id",
    "schema_version",
    "lifecycle_stage",
    "images",
    "constraints",
    "audit"
  ],
  "properties": {
    "image_spec_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "config_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "ai_image_spec_ready"},
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image_id",
          "image_type",
          "section_index",
          "section_heading",
          "purpose",
          "prompt",
          "aspect_ratio",
          "width",
          "height",
          "placement",
          "alt_text_status"
        ],
        "properties": {
          "image_id": {"type": "string", "minLength": 1},
          "image_type": {"enum": ["hero", "section", "infographic", "comparison"]},
          "section_index": {"type": "integer", "minimum": 0},
          "section_heading": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "aspect_ratio": {"enum": ["16:9", "4:3", "1:1"]},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "placement": {"enum": ["hero", "section", "inline"]},
          "alt_text_status": {"const": "pending"}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_access", "provider_call", "brand_style_included", "media_strategy_included"],
      "properties": {
        "network_access": {"const": false},
        "provider_call": {"const": false},
        "brand_style_included": {"const": false},
        "media_strategy_included": {"const": false}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "validation_status": {"const": "validated"}
      }
    }
  }
}
