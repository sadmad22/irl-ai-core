{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/p0-integration.schema.json",
  "title": "IRL P0 Integration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "integration_id",
    "brief_id",
    "report_id",
    "decision_id",
    "strategy_id",
    "schema_version",
    "lifecycle_stage",
    "signals",
    "content_score",
    "audit"
  ],
  "properties": {
    "integration_id": {
      "type": "string",
      "minLength": 1
    },
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "lifecycle_stage": {
      "const": "p0_integration_ready"
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality",
        "seo",
        "semantic",
        "competitive",
        "configuration"
      ],
      "properties": {
        "quality": {
          "$ref": "#/$defs/signal"
        },
        "seo": {
          "$ref": "#/$defs/signal"
        },
        "semantic": {
          "$ref": "#/$defs/signal"
        },
        "competitive": {
          "$ref": "#/$defs/signal"
        },
        "configuration": {
          "$ref": "#/$defs/signal"
        }
      }
    },
    "content_score": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "version",
        "validation_status",
        "content_score_status"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "validation_status": {
          "const": "validated"
        },
        "content_score_status": {
          "const": "not_calculated"
        }
      }
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "required": [
        "available",
        "source"
      ],
      "properties": {
        "available": {
          "const": true
        },
        "source": {
          "type": "object",
          "required": [
            "contract"
          ],
          "properties": {
            "contract": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}