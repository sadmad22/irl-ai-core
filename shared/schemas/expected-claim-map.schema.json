{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irl-ai-core.local/schemas/expected-claim-map.schema.json",
  "title": "IRL Expected Claim Map",
  "description": "Section-level expected claim families used by Section Evidence Readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_version", "sections"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "map_version": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": false,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "claim_family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "attribute", "role", "evidence_kind"],
      "properties": {
        "claim_type": { "type": "string", "minLength": 1 },
        "attribute": { "type": "string", "minLength": 1 },
        "role": { "enum": ["required", "supporting"] },
        "evidence_kind": { "enum": ["substantive", "signal"] }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_key", "heading", "required_claims", "supporting_claims", "signal_only"],
      "properties": {
        "section_key": { "type": "string", "minLength": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "required_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_family" }
        },
        "supporting_claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_family" }
        },
        "signal_only": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
