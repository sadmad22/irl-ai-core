{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irl-ai-core.local/schemas/evidence.schema.json",
  "title": "Research Evidence Model",
  "description": "Canonical, traceable evidence item used by ResearchReport and downstream decision layers.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "report_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["observation", "derived", "comparison", "contradiction"]
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "Research domain such as intent, serp, competition, entity, question, business, authority, topic, or content."
    },
    "subject": { "$ref": "#/$defs/reference" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "attribute": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "attribute"]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["categorical", "numeric", "boolean", "text", "list", "object"]
        },
        "data": {}
      },
      "required": ["type", "data"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "source_id": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "retrieved_at": { "type": ["string", "null"] }
      },
      "required": ["type", "source_id", "provider", "retrieved_at"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analyzer": { "type": "string", "minLength": 1 },
        "analyzer_version": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 }
      },
      "required": ["analyzer", "analyzer_version", "method"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "relation": {
      "type": "string",
      "enum": ["supports", "contradicts", "qualifies", "neutral"]
    },
    "derived_from": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "captured_at": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["active", "superseded", "invalidated"]
    }
  },
  "required": [
    "evidence_id", "report_id", "schema_version", "type", "domain",
    "subject", "claim", "value", "source", "provenance", "confidence",
    "relation", "derived_from", "captured_at", "status"
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "id"]
    }
  }
}
