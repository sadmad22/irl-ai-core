{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irl-ai-core.local/schemas/core-orchestration.schema.json",
  "title": "IRL Core Decision Orchestration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orchestration_id",
    "project_name",
    "schema_version",
    "lifecycle_stage",
    "current_stage",
    "next_action",
    "decision_outcome",
    "rationale",
    "gates",
    "audit"
  ],
  "properties": {
    "orchestration_id": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"enum": ["completed", "blocked", "action_required"]},
    "current_stage": {"type": "string", "minLength": 1},
    "next_action": {
      "enum": [
        "complete",
        "stop",
        "revise_article_draft",
        "revise_claims",
        "revise_seo",
        "revise_editorial",
        "deliver_wordpress_draft"
      ]
    },
    "decision_outcome": {"enum": ["approved", "rejected", "deferred"]},
    "rationale": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "article_draft_quality",
        "claim_audit",
        "seo_validation",
        "editorial_review",
        "publication",
        "wordpress_delivery"
      ],
      "properties": {
        "article_draft_quality": {"type": ["string", "null"]},
        "claim_audit": {"type": ["string", "null"]},
        "seo_validation": {"type": ["string", "null"]},
        "editorial_review": {"type": ["string", "null"]},
        "publication": {"type": ["string", "null"]},
        "wordpress_delivery": {"type": ["string", "null"]}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "validation_status": {"const": "validated"}
      }
    }
  }
}
