{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/youtube-videos.schema.json",
  "title": "IRL YouTube Videos Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["youtube_videos_id", "brief_id", "report_id", "decision_id", "strategy_id", "config_id", "outline_editor_id", "details_to_include_id", "schema_version", "lifecycle_stage", "youtube_videos", "audit"],
  "properties": {
    "youtube_videos_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "config_id": {"type": "string", "minLength": 1},
    "outline_editor_id": {"type": "string", "minLength": 1},
    "details_to_include_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "youtube_videos_ready"},
    "youtube_videos": {"$ref": "#/$defs/settings"},
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "method_version", "validation_status"],
      "properties": {
        "method": {"const": "deterministic-youtube-video-contract"},
        "method_version": {"const": "v1"},
        "validation_status": {"const": "validated"}
      }
    }
  },
  "$defs": {
    "video": {
      "type": "object", "additionalProperties": false,
      "required": ["youtube_video_id", "url", "title", "channel_title", "published_at", "duration_seconds", "thumbnail_url", "relevance_score", "source"],
      "properties": {
        "youtube_video_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "url": {"type": "string", "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]+$"},
        "title": {"type": "string", "minLength": 1},
        "channel_title": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "integer", "minimum": 0},
        "thumbnail_url": {"type": "string", "minLength": 1},
        "relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "source": {"const": "youtube_api"}
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "required", "max_videos", "placement", "source_requirement", "videos"],
      "properties": {
        "enabled": {"type": "boolean"},
        "required": {"type": "boolean"},
        "max_videos": {"type": "integer", "minimum": 0},
        "placement": {"enum": ["intro", "body", "conclusion"]},
        "source_requirement": {"const": "youtube_api"},
        "videos": {"type": "array", "items": {"$ref": "#/$defs/video"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"youtube_videos": {"properties": {"enabled": {"const": false}}}}},
      "then": {"properties": {"youtube_videos": {"properties": {"max_videos": {"const": 0}, "videos": {"maxItems": 0}}}}}
    },
    {
      "if": {"properties": {"youtube_videos": {"properties": {"required": {"const": true}}}}},
      "then": {"properties": {"youtube_videos": {"properties": {"enabled": {"const": true}, "videos": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"youtube_videos": {"properties": {"enabled": {"const": true}}}}},
      "then": {"properties": {"youtube_videos": {"properties": {"max_videos": {"minimum": 1}}}}}
    }
  ]
}
