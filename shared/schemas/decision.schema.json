{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irl-ai-core.local/schemas/decision.schema.json",
  "title": "IRL AI Core Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "report_id", "recommendation_id", "schema_version", "lifecycle_stage", "outcome", "rationale", "recommendation_ref", "evidence_refs", "audit"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "recommendation_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "decision_ready"},
    "outcome": {"enum": ["approved", "rejected", "deferred"]},
    "rationale": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recommendation_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "validation_status": {"enum": ["pending", "validated"]}
      }
    }
  }
}
