{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/content-brief.schema.json",
  "title": "IRL Content Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["brief_id", "report_id", "decision_id", "strategy_id", "schema_version", "lifecycle_stage", "content_type", "primary_keyword", "search_intent", "audience", "objective", "title_direction", "outline", "required_entities", "required_questions", "evidence_refs", "editorial_constraints", "audit"],
  "properties": {
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "content_brief_ready"},
    "content_type": {"enum": ["guide", "comparison", "buyer_guide", "article"]},
    "primary_keyword": {"type": "string", "minLength": 1},
    "search_intent": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "title_direction": {"type": "string", "minLength": 1},
    "outline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "purpose"],
        "properties": {
          "heading": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_entities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "editorial_constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "validation_status": {"enum": ["pending", "validated"]}
      }
    }
  }
}
