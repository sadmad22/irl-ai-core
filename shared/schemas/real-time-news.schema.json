{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/real-time-news.schema.json",
  "title": "IRL AI Core Real-Time News v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["real_time_news_id", "brief_id", "report_id", "decision_id", "strategy_id", "schema_version", "method_version", "lifecycle_stage", "as_of", "freshness_hours", "items", "audit"],
  "properties": {
    "real_time_news_id": {"type": "string", "pattern": "^news_[A-Za-z0-9_-]{16}$"},
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "method_version": {"const": "v1"},
    "lifecycle_stage": {"const": "real_time_news_ready"},
    "as_of": {"type": "string", "format": "date-time"},
    "freshness_hours": {"type": "integer", "minimum": 1, "maximum": 168},
    "items": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/item"}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["method", "source", "validation_status"], "properties": {"method": {"const": "verified_news_selection"}, "source": {"const": "news_api"}, "validation_status": {"const": "validated"}}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["news_id", "url", "title", "published_at", "summary", "relevance_score"],
      "properties": {
        "news_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "title": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date-time"},
        "summary": {"type": "string", "minLength": 1},
        "relevance_score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
