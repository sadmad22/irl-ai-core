{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/article-config.schema.json",
  "title": "IRL Article Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_id", "brief_id", "report_id", "decision_id", "strategy_id", "schema_version", "lifecycle_stage", "article_type", "article_size", "target_country", "word_target", "heading_target", "h3_target", "audit"],
  "properties": {
    "config_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "article_config_ready"},
    "article_type": {"enum": ["guide", "comparison", "buyer_guide", "article"]},
    "article_size": {"enum": ["short", "standard", "long"]},
    "target_country": {"type": "string", "minLength": 1},
    "word_target": {"$ref": "#/$defs/target"},
    "heading_target": {"$ref": "#/$defs/target"},
    "h3_target": {"$ref": "#/$defs/target"},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status", "target_policy"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "validation_status": {"const": "validated"},
        "target_policy": {"const": "explicit_country_required"}
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "target", "max"],
      "properties": {
        "min": {"type": "integer", "minimum": 0},
        "target": {"type": "integer", "minimum": 0},
        "max": {"type": "integer", "minimum": 0}
      }
    }
  }
}
