{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://insurancereviewlab.com/schemas/editorial-review.schema.json",
  "title":"IRL Editorial Review",
  "type":"object","additionalProperties":false,
  "required":["review_id","draft_id","brief_id","report_id","decision_id","strategy_id","schema_version","lifecycle_stage","outcome","checks","evidence_refs","findings","audit"],
  "properties":{
    "review_id":{"type":"string","minLength":1},"draft_id":{"type":"string","minLength":1},"brief_id":{"type":"string","minLength":1},"report_id":{"type":"string","minLength":1},"decision_id":{"type":"string","minLength":1},"strategy_id":{"type":"string","minLength":1},
    "schema_version":{"const":"1.0"},"lifecycle_stage":{"const":"editorial_review_ready"},
    "outcome":{"enum":["approved","needs_revision","rejected"]},
    "checks":{"type":"object","additionalProperties":false,"required":["structure","evidence_coverage","unsupported_claims","editorial_compliance"],"properties":{
      "structure":{"type":"boolean"},"evidence_coverage":{"type":"boolean"},"unsupported_claims":{"type":"boolean"},"editorial_compliance":{"type":"boolean"}
    }},
    "evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "findings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["severity","category","message"],"properties":{"severity":{"enum":["info","warning","critical"]},"category":{"type":"string","minLength":1},"message":{"type":"string","minLength":1}}}},
    "audit":{"type":"object","additionalProperties":false,"required":["method","version","validation_status"],"properties":{"method":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"validation_status":{"enum":["pending","validated"]}}}
  }
}
