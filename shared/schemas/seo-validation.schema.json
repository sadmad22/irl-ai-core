{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://insurancereviewlab.com/schemas/seo-validation.schema.json",
  "title":"IRL SEO Validation",
  "type":"object","additionalProperties":false,
  "required":["seo_validation_id","draft_id","brief_id","report_id","decision_id","strategy_id","seo_strategy_id","schema_version","lifecycle_stage","outcome","checks","findings","evidence_refs","audit"],
  "properties":{
    "seo_validation_id":{"type":"string","minLength":1},"draft_id":{"type":"string","minLength":1},"brief_id":{"type":"string","minLength":1},"report_id":{"type":"string","minLength":1},"decision_id":{"type":"string","minLength":1},"strategy_id":{"type":"string","minLength":1},"seo_strategy_id":{"type":"string","minLength":1},
    "schema_version":{"const":"1.0"},"lifecycle_stage":{"const":"seo_validation_ready"},
    "outcome":{"enum":["passed","needs_revision"]},
    "checks":{"type":"object","additionalProperties":false,"required":["primary_keyword","title","headings","evidence_lineage","structure"],"properties":{"primary_keyword":{"type":"boolean"},"title":{"type":"boolean"},"headings":{"type":"boolean"},"evidence_lineage":{"type":"boolean"},"structure":{"type":"boolean"}}},
    "findings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["severity","category","message"],"properties":{"severity":{"enum":["info","warning","critical"]},"category":{"type":"string","minLength":1},"message":{"type":"string","minLength":1}}}},
    "evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "audit":{"type":"object","additionalProperties":false,"required":["method","version","validation_status"],"properties":{"method":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"validation_status":{"const":"validated"}}}
  }
}
