{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/content-strategy.schema.json",
  "title": "IRL Content Strategy",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategy_id", "report_id", "decision_id", "schema_version", "lifecycle_stage", "content_type", "primary_keyword", "audience", "angle", "format", "sections", "evidence_refs", "audit"],
  "properties": {
    "strategy_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "content_strategy_ready"},
    "content_type": {"enum": ["guide", "comparison", "buyer_guide", "article"]},
    "primary_keyword": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "angle": {"type": "string", "minLength": 1},
    "format": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "entities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "business_goal": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "validation_status": {"enum": ["pending", "validated"]}
      }
    }
  }
}
