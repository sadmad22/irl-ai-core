{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irl-ai-core.local/schemas/extracted-passages.schema.json",
  "title": "IRL Extracted Source Passages",
  "description": "Deterministically extracted reader-facing source passages bound to a fetched source document.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "project_name": { "type": "string", "minLength": 1 },
    "request_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "passage_id": { "type": "string", "minLength": 1 },
          "source_document_id": { "type": "string", "minLength": 1 },
          "ordinal": { "type": "integer", "minimum": 0 },
          "kind": { "type": "string", "enum": ["heading", "paragraph", "list_item", "table_cell"] },
          "heading_path": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "maxItems": 6
          },
          "text": { "type": "string", "minLength": 1 },
          "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "char_start": { "type": "integer", "minimum": 0 },
          "char_end": { "type": "integer", "minimum": 1 }
        },
        "required": [
          "passage_id", "source_document_id", "ordinal", "kind",
          "heading_path", "text", "text_sha256", "char_start", "char_end"
        ]
      }
    }
  },
  "required": ["schema_version", "project_name", "request_fingerprint", "passages"]
}