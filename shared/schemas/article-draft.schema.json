{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/article-draft.schema.json",
  "title": "IRL Article Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["draft_id", "brief_id", "report_id", "decision_id", "strategy_id", "schema_version", "lifecycle_stage", "title", "content_type", "primary_keyword", "sections", "evidence_refs", "editorial_constraints", "audit"],
  "properties": {
    "draft_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "draft_ready"},
    "title": {"type": "string", "minLength": 1},
    "content_type": {"enum": ["guide", "comparison", "buyer_guide", "article"]},
    "primary_keyword": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "body", "purpose", "evidence_refs", "claims"],
        "properties": {
          "heading": {"type": "string", "minLength": 1},
          "body": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim_id", "text", "evidence_refs", "grounding_status"],
              "properties": {
                "claim_id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                "grounding_status": {"enum": ["grounded", "blocked", "provisional"]}
              }
            }
          }
        }
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "editorial_constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "validation_status": {"enum": ["pending", "validated"]}
      }
    }
  }
}
