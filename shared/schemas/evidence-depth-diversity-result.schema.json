{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irl-ai-core.local/schemas/evidence-depth-diversity-result.schema.json",
  "title": "IRL Evidence Depth and Diversity Result",
  "description": "Explainable Depth and source-diversity evaluation results. No composite score is defined.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "depth", "diversity", "audit"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "policy_version": { "type": "string", "minLength": 1 },
    "depth": { "$ref": "#/$defs/depth" },
    "diversity": { "$ref": "#/$defs/diversity" },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "depth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "depth_class", "substantive_support", "claim_context", "reason_codes"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "depth_class": { "enum": ["D0", "D1", "D2"] },
        "substantive_support": { "type": "boolean" },
        "claim_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_type", "attribute"],
          "properties": {
            "claim_type": { "type": "string", "minLength": 1 },
            "attribute": { "type": "string", "minLength": 1 }
          }
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "diversity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "source_instances", "source_families", "independent_root_sources", "state", "reason_codes"],
      "properties": {
        "context": { "type": "string", "minLength": 1 },
        "source_instances": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_families": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "independent_root_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "state": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
