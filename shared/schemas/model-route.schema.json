{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/model-route.schema.json",
  "title": "IRL Model Route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_id",
    "schema_version",
    "lifecycle_stage",
    "task",
    "policy",
    "effective_policy",
    "provider",
    "provider_type",
    "model",
    "adapter",
    "capabilities",
    "selection",
    "audit"
  ],
  "properties": {
    "route_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "2.0"},
    "lifecycle_stage": {"const": "model_route_ready"},
    "task": {"enum": ["research", "drafting", "revision", "editorial"]},
    "policy": {"enum": ["fast", "balanced", "quality"]},
    "effective_policy": {"enum": ["fast", "balanced", "quality"]},
    "provider": {"type": "string", "minLength": 1},
    "provider_type": {"enum": ["openai", "anthropic", "other"]},
    "model": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["fast", "balanced", "quality"]}
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fallback_used", "priority", "registry_key"],
      "properties": {
        "fallback_used": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0},
        "registry_key": {"type": "string", "minLength": 1}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "version",
        "network_access",
        "provider_call",
        "credential_access",
        "validation_status"
      ],
      "properties": {
        "method": {"const": "deterministic_provider_registry_policy"},
        "version": {"const": "v2"},
        "network_access": {"const": false},
        "provider_call": {"const": false},
        "credential_access": {"const": false},
        "validation_status": {"const": "validated"}
      }
    }
  }
}
