{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irl-ai-core.local/schemas/source-backed-claim-candidate.schema.json",
  "title": "IRL Source-Backed Claim Candidate",
  "description": "A proposed substantive claim that is explicitly bound to one source document and one or more extracted passages. Acceptance is controlled by the deterministic claim validator, not by the proposing provider.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "project_name": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "id"]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["categorical", "numeric", "boolean", "text", "list", "object"]
        },
        "data": {}
      },
      "required": ["type", "data"]
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_document_id": { "type": "string", "minLength": 1 },
        "passage_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["source_id", "source_document_id", "passage_ids"]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "attribute": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "attribute"]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source_binding" },
        "claim": { "$ref": "#/$defs/claim" },
        "subject": { "$ref": "#/$defs/subject" },
        "value": { "$ref": "#/$defs/value" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "relation": { "type": "string", "enum": ["supports", "qualifies"] }
      },
      "required": [
        "candidate_id", "source", "claim", "subject", "value",
        "confidence", "relation"
      ]
    }
  },
  "required": ["schema_version", "project_name", "candidates"]
}
