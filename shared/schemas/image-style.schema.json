{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/image-style.schema.json",
  "title": "IRL AI Core Image Style Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["image_style_id", "brief_id", "report_id", "decision_id", "strategy_id", "config_id", "draft_id", "image_spec_id", "schema_version", "lifecycle_stage", "visual_style", "styled_images", "constraints", "audit"],
  "properties": {
    "image_style_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "config_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "image_spec_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "image_style_ready"},
    "visual_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "palette", "visual_language", "composition", "illustration_direction", "restrictions"],
      "properties": {
        "brand": {"const": "Insurance Review Lab"},
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deep_navy", "modern_blue", "cyan_accent", "white"],
          "properties": {
            "deep_navy": {"const": "#0F172A"},
            "modern_blue": {"const": "#2563EB"},
            "cyan_accent": {"const": "#06B6D4"},
            "white": {"const": "#FFFFFF"}
          }
        },
        "visual_language": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "composition": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "illustration_direction": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "restrictions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      }
    },
    "styled_images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_id", "section_index", "section_heading", "image_type", "styled_prompt"],
        "properties": {
          "image_id": {"type": "string", "minLength": 1},
          "section_index": {"type": "integer", "minimum": 0},
          "section_heading": {"type": "string", "minLength": 1},
          "image_type": {"enum": ["hero", "section", "infographic", "comparison"]},
          "styled_prompt": {"type": "string", "minLength": 1}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_access", "provider_call", "image_analysis_call", "media_strategy_included", "source_mutation"],
      "properties": {
        "network_access": {"const": false},
        "provider_call": {"const": false},
        "image_analysis_call": {"const": false},
        "media_strategy_included": {"const": false},
        "source_mutation": {"const": false}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"const": "ai_image_spec_to_brand_visual_style"},
        "version": {"const": "v1"},
        "validation_status": {"const": "validated"}
      }
    }
  }
}
