{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/article-production.schema.json",
  "title": "IRL Article Production Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["production_id", "schema_version", "lifecycle_stage", "lineage", "article", "quality", "publication", "audit"],
  "properties": {
    "production_id": {"type": "string", "pattern": "^production_[a-f0-9]{16}$"},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "production_ready"},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "decision_id", "strategy_id", "brief_id", "draft_id", "quality_id"],
      "properties": {
        "report_id": {"type": "string", "minLength": 1},
        "decision_id": {"type": "string", "minLength": 1},
        "strategy_id": {"type": "string", "minLength": 1},
        "brief_id": {"type": "string", "minLength": 1},
        "draft_id": {"type": "string", "minLength": 1},
        "quality_id": {"type": "string", "minLength": 1},
        "config_id": {"type": "string", "minLength": 1},
        "semantic_id": {"type": "string", "minLength": 1},
        "optimization_id": {"type": "string", "minLength": 1},
        "image_spec_id": {"type": "string", "minLength": 1},
        "alt_text_id": {"type": "string", "minLength": 1},
        "external_links_id": {"type": "string", "minLength": 1},
        "internal_links_id": {"type": "string", "minLength": 1},
        "news_id": {"type": "string", "minLength": 1}
      }
    },
    "article": {"$ref": "article-draft.schema.json"},
    "quality": {"$ref": "article-draft-quality.schema.json"},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "publish", "human_approval_required"],
      "properties": {
        "mode": {"const": "wordpress_draft"},
        "publish": {"const": false},
        "human_approval_required": {"const": true}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"const": "article_production_contract"},
        "version": {"const": "v1"},
        "validation_status": {"const": "validated"}
      }
    }
  }
}
