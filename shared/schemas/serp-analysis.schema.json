{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SERP Analysis Model",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "position_semantics": {
      "const": "provider_order"
    },
    "keyword": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 2
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          }
        },
        "required": [
          "position",
          "title",
          "url",
          "domain",
          "snippet"
        ]
      }
    }
  },
  "required": [
    "keyword",
    "country",
    "language",
    "results"
  ]
}
