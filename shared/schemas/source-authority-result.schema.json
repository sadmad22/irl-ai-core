{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irl-ai-core.local/schemas/source-authority-result.schema.json",
  "title": "IRL Source Authority Result",
  "description": "Claim-relative authority assessment for a source. This is an evaluation result, not source identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "source_id", "source_class", "authority_state", "scope_match", "claim_context", "reason_codes", "audit"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "policy_version": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "source_class": { "enum": ["A_primary_official", "B_institutional_professional", "C_reputable_secondary", "D_community_informal", "E_discovery_search_surface"] },
    "authority_state": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
    "scope_match": { "enum": ["match", "mismatch", "unknown"] },
    "claim_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "attribute"],
      "properties": {
        "claim_type": { "type": "string", "minLength": 1 },
        "attribute": { "type": "string", "minLength": 1 }
      }
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
