{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent Alignment Model",
  "type": "object",
  "properties": {
    "keyword": {
      "type": "string"
    },
    "query_primary_intent": {
      "type": ["string", "null"],
      "enum": ["Informational", "Commercial", "Transactional", "Navigational", null]
    },
    "serp_dominant_intent": {
      "type": ["string", "null"],
      "enum": ["Informational", "Commercial", "Transactional", "Navigational", null]
    },
    "alignment": {
      "type": "string",
      "enum": ["aligned", "mixed", "misaligned", "indeterminate"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "serp_mixed": {
      "type": "boolean"
    },
    "intent_distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  "required": [
    "keyword",
    "query_primary_intent",
    "serp_dominant_intent",
    "alignment",
    "confidence",
    "serp_mixed",
    "intent_distribution"
  ]
}
