{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/ai-content-cleaning.schema.json",
  "title": "AI Content Cleaning Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["editorial_cleanup_id", "draft_id", "brief_id", "report_id", "decision_id", "strategy_id", "schema_version", "lifecycle_stage", "status", "cleaned_sections", "changes", "risk_flags", "constraints", "audit"],
  "properties": {
    "editorial_cleanup_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "editorial_cleanup_ready"},
    "status": {"enum": ["cleaned", "unchanged", "needs_review"]},
    "cleaned_sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["section_index", "heading", "original_body", "cleaned_body"],
        "properties": {
          "section_index": {"type": "integer", "minimum": 0},
          "heading": {"type": "string", "minLength": 1},
          "original_body": {"type": "string", "minLength": 1},
          "cleaned_body": {"type": "string", "minLength": 1}
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["section_index", "category", "description"],
        "properties": {
          "section_index": {"type": "integer", "minimum": 0},
          "category": {"enum": ["grammar", "clarity", "redundancy", "formatting", "ai_artifact"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "risk_flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["claim_change", "new_fact", "citation_change", "structural_change", "meaning_change"]}},
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["network_access", "provider_call", "source_mutation", "draft_mutation", "new_facts", "claim_rewriting", "structure_rewriting"],
      "properties": {
        "network_access": {"const": false},
        "provider_call": {"const": true},
        "source_mutation": {"const": false},
        "draft_mutation": {"const": false},
        "new_facts": {"const": false},
        "claim_rewriting": {"const": false},
        "structure_rewriting": {"const": false}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"const": "injected_llm_editorial_cleanup"},
        "version": {"const": "v1"},
        "validation_status": {"const": "validated"}
      }
    }
  }
}
