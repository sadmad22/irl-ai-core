{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/article-structure.schema.json",
  "title": "IRL Article Structure Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["structure_id", "brief_id", "report_id", "decision_id", "strategy_id", "schema_version", "lifecycle_stage", "hook", "conclusion", "h3", "tables", "lists", "faq", "audit"],
  "properties": {
    "structure_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "article_structure_ready"},
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "hook_type"],
      "properties": {
        "required": {"type": "boolean"},
        "hook_type": {"type": ["string", "null"], "enum": ["question", "benefit", "problem", "statistic", "scenario", "contrarian", "direct_answer", null]}
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {"required": {"type": "boolean"}}
    },
    "h3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "integer", "minimum": 0},
        "max": {"type": "integer", "minimum": 0}
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "required", "count"],
      "properties": {
        "enabled": {"type": "boolean"},
        "required": {"type": "boolean"},
        "count": {
          "type": "object", "additionalProperties": false, "required": ["min", "max"],
          "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "required", "count"],
      "properties": {
        "enabled": {"type": "boolean"},
        "required": {"type": "boolean"},
        "count": {
          "type": "object", "additionalProperties": false, "required": ["min", "max"],
          "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "required", "count", "answer_required"],
      "properties": {
        "enabled": {"type": "boolean"},
        "required": {"type": "boolean"},
        "answer_required": {"type": "boolean"},
        "count": {
          "type": "object", "additionalProperties": false, "required": ["min", "max"],
          "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "validation_status": {"const": "validated"}
      }
    }
  }
}
