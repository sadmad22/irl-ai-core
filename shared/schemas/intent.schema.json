{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Search Intent Model",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Informational, Commercial, Transactional, Navigational"
    },
    "confidence": {
      "type": "number",
      "description": "Confidence score"
    }
  },
  "required": [
    "type",
    "confidence"
  ]
}