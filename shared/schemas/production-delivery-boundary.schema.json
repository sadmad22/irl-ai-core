{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/production-delivery-boundary.schema.json",
  "title": "IRL Production Delivery Boundary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["delivery_id", "package_id", "publisher_id", "adapter_id", "target", "execution_mode", "publication", "request", "lifecycle_stage", "delivery_status", "audit"],
  "properties": {
    "delivery_id": {"type": "string", "pattern": "^delivery_[a-f0-9]{16}$"},
    "package_id": {"type": "string", "pattern": "^package_[a-f0-9]{16}$"},
    "publisher_id": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "target": {"const": "wordpress"},
    "execution_mode": {"enum": ["dry_run", "live"]},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "publish", "human_approval_required"],
      "properties": {
        "mode": {"const": "wordpress_draft"},
        "publish": {"const": false},
        "human_approval_required": {"const": true}
      }
    },
    "request": {"$ref": "#/$defs/request"},
    "lifecycle_stage": {"enum": ["delivery_ready", "delivered_as_draft", "human_review"]},
    "delivery_status": {"enum": ["ready", "delivered", "failed"]},
    "response": {"$ref": "#/$defs/response"},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"const": "production_delivery_boundary"},
        "version": {"const": "v1"},
        "validation_status": {"const": "validated"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"delivery_status": {"const": "delivered"}}},
      "then": {"required": ["response"], "properties": {"lifecycle_stage": {"enum": ["delivered_as_draft", "human_review"]}, "response": {"required": ["platform_post_id", "remote_status"]}}}
    },
    {
      "if": {"properties": {"delivery_status": {"const": "failed"}}},
      "then": {"required": ["response"], "properties": {"response": {"required": ["error_code", "error_message"]}}}
    }
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "uniqueStringArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "content", "status", "media", "links", "optimization", "taxonomy"],
      "properties": {
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "content": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"const": "draft"},
        "slug": {"$ref": "#/$defs/nonEmptyString"},
        "excerpt": {"type": "string"},
        "media": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image_id", "asset_ref", "alt_text", "placement"],
            "properties": {
              "image_id": {"$ref": "#/$defs/nonEmptyString"},
              "asset_ref": {"$ref": "#/$defs/nonEmptyString"},
              "alt_text": {"$ref": "#/$defs/nonEmptyString"},
              "placement": {"$ref": "#/$defs/nonEmptyString"},
              "featured": {"type": "boolean"}
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["link_id", "target_url", "anchor_text", "placement", "kind"],
            "properties": {
              "link_id": {"$ref": "#/$defs/nonEmptyString"},
              "target_url": {"type": "string", "format": "uri", "minLength": 1},
              "anchor_text": {"$ref": "#/$defs/nonEmptyString"},
              "placement": {"$ref": "#/$defs/nonEmptyString"},
              "kind": {"enum": ["internal", "external"]}
            }
          }
        },
        "optimization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seo_title", "meta_description"],
          "properties": {
            "seo_title": {"$ref": "#/$defs/nonEmptyString"},
            "meta_description": {"$ref": "#/$defs/nonEmptyString"},
            "canonical_url": {"type": "string", "format": "uri"}
          }
        },
        "taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["categories", "tags"],
          "properties": {
            "categories": {"$ref": "#/$defs/uniqueStringArray", "minItems": 1},
            "tags": {"$ref": "#/$defs/uniqueStringArray"}
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform_post_id": {"type": "integer", "minimum": 1},
        "remote_status": {"const": "draft"},
        "edit_url": {"type": "string", "format": "uri"},
        "error_code": {"$ref": "#/$defs/nonEmptyString"},
        "error_message": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}
