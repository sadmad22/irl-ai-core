{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurancereviewlab.com/schemas/alt-text.schema.json",
  "title": "IRL Automatic Informative Alt Text",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alt_text_id",
    "brief_id",
    "report_id",
    "decision_id",
    "strategy_id",
    "config_id",
    "draft_id",
    "image_spec_id",
    "schema_version",
    "lifecycle_stage",
    "alt_texts",
    "constraints",
    "audit"
  ],
  "properties": {
    "alt_text_id": {"type": "string", "minLength": 1},
    "brief_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "config_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "image_spec_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "lifecycle_stage": {"const": "alt_text_ready"},
    "alt_texts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_id", "section_index", "section_heading", "alt_text", "status"],
        "properties": {
          "image_id": {"type": "string", "minLength": 1},
          "section_index": {"type": "integer", "minimum": 0},
          "section_heading": {"type": "string", "minLength": 1},
          "alt_text": {"type": "string", "minLength": 1, "maxLength": 250},
          "status": {"const": "ready"}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_access", "provider_call", "image_analysis_call", "keyword_stuffing", "image_spec_mutation"],
      "properties": {
        "network_access": {"const": false},
        "provider_call": {"const": false},
        "image_analysis_call": {"const": false},
        "keyword_stuffing": {"const": false},
        "image_spec_mutation": {"const": false}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "version", "validation_status"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "validation_status": {"const": "validated"}
      }
    }
  }
}
