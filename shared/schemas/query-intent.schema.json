{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query Intent Model",
  "type": "object",
  "properties": {
    "keyword": { "type": "string" },
    "primary_intent": {
      "type": "string",
      "enum": ["Informational", "Commercial", "Transactional", "Navigational"]
    },
    "secondary_intent": {
      "type": ["string", "null"],
      "enum": ["Informational", "Commercial", "Transactional", "Navigational", null]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "scores": { "type": "object" },
    "signals": { "type": "object" }
  },
  "required": ["keyword", "primary_intent", "secondary_intent", "confidence"]
}
