# IRL AI Core — production environment contract
# Copy into the local secrets/environment manager. Do not commit populated secrets.

IRL_ENVIRONMENT=production

# Capability-specific production providers.
IRL_SERP_PROVIDER=brave
IRL_KEYWORD_METRICS_PROVIDER=google_ads

# Brave
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_TIMEOUT_SECONDS=15

# Google Ads
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_TIMEOUT_SECONDS=20
GOOGLE_ADS_MAX_KEYWORDS_PER_REQUEST=10000

# OAuth / API endpoints may be overridden for controlled environments.
GOOGLE_ADS_BASE_URL=https://googleads.googleapis.com
GOOGLE_ADS_TOKEN_URL=https://oauth2.googleapis.com/token
